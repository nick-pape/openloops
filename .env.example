# Open Loops Configuration
# Copy this file to .env and fill in your values

# Microsoft Graph Configuration
# Register an app at: https://portal.azure.com -> App registrations
# See docs/MICROSOFT_GRAPH_SETUP.md for detailed setup instructions
MS_GRAPH_CLIENT_ID=your-client-id-here
MS_GRAPH_REDIRECT_URI=http://localhost:3000/auth/callback

# LLM Provider Configuration
# Leave blank to disable AI features
LLM_PROVIDER=remote
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Transcription Provider Configuration
TRANSCRIPTION_API_KEY=your-api-key-here
TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
TRANSCRIPTION_MODEL=whisper-1
